{
  "name": "boirong-cash-memo",
  "version": "1.0.0",
  "description": "Boirong Cash Memo — Windows Desktop Application",
  "main": "main.js",
  "author": "Boirong.com",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.boirong.cashmemo",
    "productName": "Boirong Cash Memo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icon.ico",
      "artifactName": "boirong-cash-memo-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "boirong-cash-memo-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Boirong Cash Memo"
    }
  }
}